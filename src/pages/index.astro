---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArtImage from '../components/ArtImage.astro';

const pieces = (await getCollection('artwork')).sort((a, b) => (b.data.year || 0) - (a.data.year || 0));
const cdnUrl = import.meta.env.PUBLIC_BUNNY_CDN_URL?.replace(/\/$/, '') || '';

function resolveFullUrl(path: string) {
  if (path.startsWith('http') || path.startsWith('/uploads')) return path;
  const clean = path.replace(/^\//, '');
  return cdnUrl ? `${cdnUrl}/${clean}` : `/${clean}`;
}
---

<BaseLayout title="Erika Lacroix — Selected Works" activeNav="works">
  <div class="max-w-6xl mx-auto px-6 sm:px-10 py-14 sm:py-20">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-16 items-start">
      {pieces.map((item) => {
        const fullUrl = resolveFullUrl(item.data.imagePath);
        return (
          <article class="group flex flex-col">
            <!-- Clickable Artwork Thumbnail -->
            <button 
              type="button"
              class="w-full text-left cursor-zoom-in relative bg-[#f2eee9] border border-stone-200/60 overflow-hidden shadow-xs hover:shadow-md transition-shadow duration-300"
              data-lightbox-trigger
              data-full-src={fullUrl}
              data-title={item.data.title}
              data-meta={`${item.data.medium} (${item.data.dimensions})`}
            >
              <ArtImage
                path={item.data.imagePath}
                alt={item.data.title}
                className="w-full h-auto max-h-[460px] object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
              />
            </button>

            <!-- Metadata Caption -->
            <div class="mt-4 space-y-1">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="font-serif-art text-2xl font-light text-stone-900 leading-tight">
                  {item.data.title}
                </h2>
                <span class="text-[11px] text-stone-400 font-mono tracking-tight">{item.data.year}</span>
              </div>
              <p class="text-[11px] uppercase tracking-wider text-stone-500 font-light">{item.data.medium}</p>
              
              <div class="flex items-center justify-between pt-1">
                <p class="text-xs text-stone-400 font-light">{item.data.dimensions}</p>
                {item.data.status && (
                  <span class={`text-[9px] uppercase tracking-widest px-2 py-0.5 border ${
                    item.data.status === 'Available'
                      ? 'border-stone-300 text-stone-800 bg-white/60'
                      : 'border-transparent text-stone-400 italic'
                  }`}>
                    {item.data.status}
                  </span>
                )}
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</BaseLayout>
