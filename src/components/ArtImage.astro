---
interface Props {
  path: string;
  alt: string;
  className?: string;
}

const { path, alt, className = '' } = Astro.props;
const cdnUrl = import.meta.env.PUBLIC_BUNNY_CDN_URL?.replace(/\/$/, '') || '';

let fullSrc = path;

// If it's a relative path from Bunny (e.g. "works/painting.jpg")
if (!path.startsWith('http') && !path.startsWith('/uploads')) {
  const cleanPath = path.replace(/^\//, '');
  fullSrc = cdnUrl ? `${cdnUrl}/${cleanPath}` : `/${cleanPath}`;
}
---

<figure class="overflow-hidden bg-stone-100">
  <img 
    src={fullSrc} 
    alt={alt} 
    loading="lazy" 
    decoding="async" 
    class={`w-full h-auto block ${className}`} 
  />
</figure>
