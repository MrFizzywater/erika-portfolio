---
interface Props {
  path: string;
  alt: string;
  className?: string;
}

const { path, alt, className = '' } = Astro.props;
const cdnUrl = import.meta.env.PUBLIC_BUNNY_CDN_URL?.replace(/\/$/, '') || '';

let fullSrc = path;

if (path.startsWith('http')) {
  // Absolute URLs stay as-is
  fullSrc = path;
} else if (path.startsWith('/uploads')) {
  // Decap CMS uploads are stored in Git / public/uploads — serve directly from site
  fullSrc = path;
} else {
  // Legacy or manual Bunny CDN paths (e.g. "works/piece-one.jpg")
  const cleanPath = path.replace(/^\//, '');
  fullSrc = cdnUrl ? `${cdnUrl}/${cleanPath}` : `/${cleanPath}`;
}
---

<figure class="overflow-hidden bg-[#f0eee9]">
  <img
    src={fullSrc}
    alt={alt}
    loading="lazy"
    decoding="async"
    class={`w-full h-auto block ${className}`}
  />
</figure>
